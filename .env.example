# =============================================================================
# Mimir environment variables (copy to .env.local; never commit secrets)
# =============================================================================
# Everything is optional for a local build: the program id, RPC endpoints and
# USDC mint fall back to the devnet defaults in lib/solana/config.ts. Workers
# need a keypair and (for the oracle/council) one LLM key.

# ── LLM (oracle, council, drafts, moderation; lib/llm.ts) ───────────────────
# Only ONE key is needed; Gemini is preferred when both are set.
# Force a provider with LLM_PROVIDER=gemini|anthropic; override the model with ORACLE_LLM_MODEL.
# GEMINI_API_KEY=...                       # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=sk-ant-...             # https://console.anthropic.com
# LLM_PROVIDER=gemini
# ORACLE_LLM_MODEL=gemini-3.5-flash        # or claude-sonnet-4-6
# How long a provider sits out after a quota error (ms): Gemini, Groq, OpenRouter
# LLM_QUOTA_COOLDOWN_MS=300000
# GROQ_QUOTA_COOLDOWN_MS=2700000
# OPENROUTER_QUOTA_COOLDOWN_MS=2700000
# OpenRouter attribution headers (optional)
# OPENROUTER_APP_NAME=Mimir
# OPENROUTER_SITE_URL=https://mimirmarkets.xyz
# Public origin for canonical and Open Graph URLs (default https://mimirmarkets.xyz)
# NEXT_PUBLIC_SITE_URL=https://mimirmarkets.xyz

# ── Oracle worker (agents/oracle/solana.ts) ─────────────────────────────────
# Poll interval and min ms between oracle LLM calls
# ORACLE_POLL_INTERVAL_MS=30000
# ORACLE_LLM_THROTTLE_MS=0
# Auto-challenger: the oracle stakes on mispriced open claims
# AUTO_CHALLENGE=1
# CHALLENGE_STAKE_USDC=2        # USDC per challenge (default: 2)
# CHALLENGE_CONFIDENCE=80       # min confidence % to auto-stake (default: 80)
# Optional CoinGecko demo/pro key for evidence fetches (keyless works, rate-limited)
# COINGECKO_API_KEY=
# Fund the worker wallets with devnet USDC: https://faucet.circle.com (Solana Devnet)
# The oracle's own LLM keys. On mainnet they are REQUIRED and the oracle never
# falls back to GEMINI_API_KEY / ANTHROPIC_API_KEY (web routes can drain those);
# web and council callers never use these.
# ORACLE_GEMINI_API_KEY=
# ORACLE_ANTHROPIC_API_KEY=
# Models a settlement verdict may come from (Gemini/Claude only; Groq, OpenRouter,
# ":free" and Gemma never settle). None available → the oracle retries later.
# SETTLEMENT_MODELS=gemini-3.5-flash,gemini-3.5-pro,claude-sonnet-4-6
# (ORACLE_LLM_THROTTLE_MS now defaults to 1500)
# Auto-challenge stays off on mainnet unless this is also set
# AUTO_CHALLENGE_MAINNET=1
# A challenge stake never exceeds this multiple of the creator's stake (Kelly at pool odds)
# CHALLENGE_MAX_CREATOR_MULTIPLE=1
# Live quotes must be within this of the deadline (ms). History sources carry their own
# window (CoinGecko/CMC: half their sampling interval; Chainlink: the round current at the deadline)
# PRICE_MAX_DEADLINE_SKEW_MS=60000
# Oldest Chainlink round accepted as the deadline price (s; the feeds' heartbeat)
# CHAINLINK_MAX_ROUND_AGE_S=3600
# A price claim with fewer than two deadline readings waits this long, then refunds (never an LLM call)
# PRICE_DEFER_HOURS=6
# DEX-priced tokens ($ANSEM, the Mimir token): pools thinner than this are ignored
# DEX_MIN_LIQUIDITY_USD=250000
# Disputes and refused proposals are POSTed here as {"text": "..."} (Slack/Telegram relay)
# ALERT_WEBHOOK_URL=

# ── Neon Postgres (server-side read index, optional) ─────────────────────────
# Chain state is always the source of truth. Neon is a read index for the
# arena feed, dashboard, notifications, agent registry, baskets, copy trading
# and challenge opportunities. Without it pages fall back to chain reads and
# the DB-only features say they are not configured.
# DATABASE_URL=postgresql://<user>:<pwd>@<host>/<db>?sslmode=require

# ── Indexer worker (agents/indexer/solana.ts) ───────────────────────────────
# INDEXER_POLL_INTERVAL_MS=30000
# Pause between per-claim reads (ms), to stay under public RPC limits
# INDEXER_CLAIM_DELAY_MS=150

# ── Claim generation (AI-assisted create flow) ────────────────────────────────
# NEXT_PUBLIC_FEATURE_SOURCE_DRAFTS=1
# CLAIM_DRAFT_MODEL=gemini-3.5-flash

# ── Moderation ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_FEATURE_CLAIM_MODERATION=1
# CLAIM_MODERATION_MODEL=gemini-3.5-flash
# Deploy-wide ceilings (requests/minute, all callers together) for the public
# LLM routes, on top of the per-IP limits (lib/server/llm-route-guard.ts)
# CLAIM_MODERATION_GLOBAL_PER_MIN=120
# CLAIM_DRAFT_GLOBAL_PER_MIN=30
# COUNCIL_PREFLIGHT_GLOBAL_PER_MIN=30
# COUNCIL_REASONING_GLOBAL_PER_MIN=60

# ── Web ───────────────────────────────────────────────────────────────────────
# Port for `npm run start:all` / start:railway (Railway sets it)
# PORT=3000
# NEXT_PUBLIC_CMC_LOGO is set by next.config.js at build time (when
# public/brand/coinmarketcap.svg exists); do not set it by hand.
# What `npm run start:all` runs: web | workers | unset (both, dev/devnet only).
# Mainnet runs two services (docs/SOLANA.md "Deploy (mainnet)"); the web one
# gets NO keypair env. start:all refuses both-in-one on mainnet unless
# START_ALL_MAINNET=1.
# MIMIR_SERVICE=
# START_ALL_MAINNET=
# Proxies in front of the app that append to X-Forwarded-For (Railway edge: 1).
# The client IP for rate limits is taken this many entries from the right;
# 0 ignores X-Forwarded-For and uses X-Real-IP only.
# TRUSTED_PROXY_HOPS=1

# ══════════════════════════════════════════════════════════════════════════
# SOLANA × MAGICBLOCK ER × FLASH TRADE (primary runtime)
# ══════════════════════════════════════════════════════════════════════════

# ── Solana base layer ─────────────────────────────────────────────────────
# devnet (default) | mainnet-beta. On mainnet nothing falls back to a devnet default:
# NEXT_PUBLIC_MIMIR_PROGRAM_ID, NEXT_PUBLIC_SOLANA_RPC and NEXT_PUBLIC_MAGICBLOCK_ER_RPC must be
# set at build time (next.config.js fails the build otherwise), and USDC is Circle's mainnet mint.
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# A NEXT_PUBLIC_ RPC with a key/query string is refused on mainnet (it ships in the browser bundle);
# put keyed RPCs in SOLANA_RPC / MAGICBLOCK_ER_RPC (server-only, preferred by the server), or set
# this to 1 only when the key is origin-locked at the provider.
# NEXT_PUBLIC_RPC_ORIGIN_LOCKED=
# V3 program (optimistic resolution, disputes, fees). Set it on Railway web +
# workers so a stale value never points at the pre-V3 program
# (J9MZfzQt2LVkdfvqvTRPhcSN41gSmGKDWNVjxUQPxSDR, history only).
# NEXT_PUBLIC_MIMIR_PROGRAM_ID=EnLyMg9fBhgvKcWVAyD1YKv3i2BbLejfRFb5hEXur1WE
# Devnet RPC (browser + server); SOLANA_RPC is a server-only alternative
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# SOLANA_RPC=
# Admin/oracle keypair: JSON array or base64 in SOLANA_KEYPAIR_JSON (Railway),
# else a solana-keygen file path in SOLANA_KEYPAIR
# SOLANA_KEYPAIR_JSON=
# SOLANA_KEYPAIR=~/.config/solana/talos-deploy.json
# Market-creator keypair, kept separate so the oracle can challenge its claims
# (same formats; falls back to the admin keypair off mainnet only. REQUIRED on
# mainnet, and must differ from SOLANA_KEYPAIR: workers refuse to start otherwise)
# CREATOR_KEYPAIR_JSON=
# CREATOR_KEYPAIR=.keys/creator.json
# The creator's public key alone, for processes that only need to recognise
# house markets (oracle house set, council rule personas) without its secret
# CREATOR_PUBKEY=
# Circle's official devnet USDC (6 decimals). Wallets are funded from
# https://faucet.circle.com → Solana Devnet (no local mint authority).
# SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Browser-side override of the same mint (defaults to the value above)
# NEXT_PUBLIC_SOLANA_USDC_MINT=
# Per-request deadline for server-side Solana/ER JSON-RPC calls (ms)
# SOLANA_RPC_TIMEOUT_MS=20000

# ── Program init (scripts/solana/initialize.ts, one-time) ─────────────────
# Oracle + platform fee recipient (default: the admin keypair, devnet only).
# REQUIRED on mainnet and must differ from the admin; initialize.ts and every
# admin.ts write also need --yes there.
# MIMIR_ORACLE=
# MIMIR_FEE_RECIPIENT=
# Fees on winners' profit only, platform + agent owner ≤ 1000 bps total
# MIMIR_PLATFORM_FEE_BPS=50
# MIMIR_AGENT_FEE_BPS=50
# How long a proposed verdict is disputable (0 = settle instantly, max 7 days)
# MIMIR_DISPUTE_WINDOW_SECONDS=86400
# After deadline + this, anyone can refund an unresolved claim (60s..30d)
# MIMIR_RESOLUTION_GRACE_SECONDS=604800
# Oracle: back-off after a failed finalize/refund/payout crank (ms)
# ORACLE_CRANK_BACKOFF_MS=120000
# Agent owners whose fee account (FeeBalance PDA) the payout cranker may open,
# paying the rent (comma-separated base58). Others open their own.
# AGENT_FEE_ALLOWLIST=

# ── MagicBlock Ephemeral Rollup ───────────────────────────────────────────
# Regional ER endpoint (or https://devnet-router.magicblock.app for routing)
# MAGICBLOCK_ER_RPC=https://devnet-as.magicblock.app/
# Browser-side ER endpoint (defaults to MAGICBLOCK_ER_RPC)
# NEXT_PUBLIC_MAGICBLOCK_ER_RPC=
# MAGICBLOCK_ER_WS=wss://devnet-as.magicblock.app/
# ER validator identity for DelegateConfig (Asia devnet default)
# MAGICBLOCK_ER_VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57

# ── Flash Trade (free public API, no key needed, 10 req/s) ────────────────
# Auto-hedge mode for the oracle's challenge stakes:
#   dry  = build the perp tx via Flash transaction-builder, log it, don't sign
#   live = sign + submit (Flash Trade runs on MAINNET, so real funds!)
#   off  = no hedging
# HEDGE_MODE=dry
# Only dry|live|off are accepted (anything else stops the worker). Unset: off on
# mainnet, dry elsewhere. live opens positions the oracle never closes, so it
# also needs this explicit acknowledgement; every built tx is checked (fee
# payer + Flash/ComputeBudget/ATA programs only) before it is signed.
# HEDGE_ALLOW_UNMANAGED=1
# live signs with its own low-balance wallet, never the oracle key (required for live)
# HEDGE_KEYPAIR_JSON=
# HEDGE_KEYPAIR=.keys/hedge.json
# Highest priority fee a Flash-built hedge tx may set (micro-lamports per CU)
# HEDGE_MAX_PRIORITY_MICRO_LAMPORTS=1000000

# ── Ops: pause switches + feature flags (lib/ops/flags.ts) ────────────────
# Pause one capability without a code change (off-chain: stops our own
# workers from signing). The program has its own admin pause
# (scripts/solana/admin.ts pause) that blocks create/challenge/propose for
# everyone but never withdrawals, payouts, refunds or disputes. Set to 1:
# MIMIR_PAUSE_ORACLE_SETTLEMENT=  # oracle stops resolving expired claims
# MIMIR_PAUSE_AUTO_CHALLENGE=     # oracle stops early challenge stakes
# MIMIR_PAUSE_STAKE=              # oracle + council stop staking
# MIMIR_PAUSE_CREATE_MARKET=      # market-creator stops creating claims
# MIMIR_PAUSE_MARKET_CREATOR_WORKER=  # market-creator skips whole cycles
# MIMIR_PAUSE_COUNCIL_WORKER=     # council skips whole cycles
# MIMIR_PAUSE_COPY_EXECUTION=     # /api/copy/signals refuses every copy (globally_paused)
# Feature flags (1 = on), e.g. alternative to AUTO_CHALLENGE=1:
# MIMIR_FEATURE_AUTO_CHALLENGE=
# Copy trading: signed copy permissions + /api/copy/* + the /copy page
# MIMIR_FEATURE_COPY_TRADING=
# Oracle: wait before re-trying a failed resolve write (ms)
# ORACLE_SETTLE_RETRY_BACKOFF_MS=120000

# Per-worker Gemini keys (own free-tier quota each; fall back to GEMINI_API_KEY)
# ORACLE_GEMINI_API_KEY=
# COUNCIL_GEMINI_API_KEY=
# Backup Gemini keys and a model pool to spread per-model free-tier limits
# GEMINI_API_KEYS=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# LLM fallbacks tried after the primary provider (lib/llm.ts provider chain)
# GROQ_API_KEY=
# GROQ_API_KEYS=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OpenRouter model; the default "openrouter/free" router is never used for settlement verdicts
# OPENROUTER_MODEL=openrouter/free
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Settlement price cross-check (lib/server/price-sources.ts) ────────────
# Optional CoinMarketCap key for a second aggregator reading (CoinGecko, Chainlink, Flash Trade are keyless)
# CMC_API_KEY=
# Ethereum mainnet RPC used for Chainlink eth_call reads
# CHAINLINK_RPC_URL=https://ethereum-rpc.publicnode.com

# ── Solana council worker ─────────────────────────────────────────────────
# COUNCIL_POLL_INTERVAL_MS=60000
# COUNCIL_PERSONA_LIMIT=0
# Web service: public persona addresses as JSON {"optimist":"<base58>",...}.
# Required on mainnet: the web never derives them from a secret there.
# COUNCIL_ADDRESSES=
# Secret the persona wallets derive from: sha256(seed ‖ "mimir-council:" ‖ slug).
# Hex or base64, ≥32 bytes (openssl rand -hex 32). REQUIRED on mainnet (persona
# keys never derive from the admin key there); off mainnet, unset keeps the old
# admin-derived devnet wallets. Setting it moves every persona to a new address:
# re-fund them and update COUNCIL_ADDRESSES (npm run system:status prints them).
# COUNCIL_KEY_SEED=
# Rule personas (contrarian, whale-watcher) only trade house markets, and are
# off on mainnet unless this is 1
# COUNCIL_RULE_PERSONAS_MAINNET=
# A persona's stake never exceeds this multiple of the creator's stake
# COUNCIL_MAX_CREATOR_MULTIPLE=1
# Run one jury only (classic | philosopher); unset runs both, for staking and the settlement jury
# COUNCIL_TRACK=
# Claims evaluated per cycle, closest deadline first
# COUNCIL_MAX_CLAIMS=12
# Min ms between council LLM calls
# COUNCIL_LLM_THROTTLE_MS=4500
# How long a persona's considered LLM abstention stands before it looks again (LLM errors retry next cycle)
# COUNCIL_REEVAL_MS=1800000
# Let personas read up to N earlier personas' takes on the same claim this cycle (makes forecasts less independent)
# COUNCIL_PEER_READS=
# COUNCIL_PEER_READS_PER_PERSONA=2
# Decide and log only: no funding, stakes or forecast rows (same as --dry-run)
# COUNCIL_DRY_RUN=
# Market-creator asks council personas to vet each draft before staking on it; drafts scoring below the minimum are dropped
# MARKET_CREATOR_PREFLIGHT=
# MARKET_CREATOR_PREFLIGHT_MIN_SCORE=60
# MARKET_CREATOR_PREFLIGHT_PERSONAS=socrates,aurelius,statistician

# ── Solana market-creator worker (agents/market-creator/solana.ts) ────────
# Draft, score and log only: no cancels, claims or delegations (same as --dry-run)
# MARKET_CREATOR_DRY_RUN=
# Borrow live, contested Polymarket questions (settled after UMA resolves them)
# MARKET_CREATOR_POLYMARKET=
# Cycle interval (ms), USDC staked per claim, crypto/ANSEM deadline horizon (min)
# CREATOR_INTERVAL_MS=3600000
# CREATOR_STAKE_USDC=3
# CREATOR_HORIZON_MIN=30
# Claims per cycle from each source
# CREATOR_CRYPTO_PER_RUN=2
# CREATOR_SPORTS_PER_RUN=3            # legacy alias: CREATOR_WORLDCUP_PER_RUN
# CREATOR_STOCKS_PER_RUN=1
# $ANSEM price markets from mainnet DEX prices (0 turns them off); threshold distance from spot.
# Default 1, but 0 on mainnet: DEX-priced tokens no longer settle from the structured resolver.
# $MIMIR claims are never drafted, on any cluster.
# CREATOR_ANSEM_PER_RUN=1
# CREATOR_ANSEM_SKEW=0.02
# CREATOR_POLYMARKET_PER_RUN=2
# Latest kickoff (hours ahead) a sports claim is drafted for
# CREATOR_SPORTS_MAX_HOURS=72
# Decidability floor (lib/claimQuality.ts, 0-100) a draft must reach
# CREATOR_MIN_QUALITY=60
# Skip drafting while this many claims are joinable (all creators)
# MAX_ACTIVE_CLAIMS=30
# Crypto thresholds outside this band of the live price are rejected
# CRYPTO_MIN_THRESHOLD_RATIO=0.65
# CRYPTO_MAX_THRESHOLD_RATIO=1.35
# How often the worker rebuilds the arena challenge opportunities (needs NEXT_PUBLIC_FEATURE_SOURCE_DRAFTS=1, DATABASE_URL, GEMINI_API_KEY; 0 = never)
# CHALLENGE_OPPORTUNITIES_REFRESH_MS=21600000

# ── Oracle settlement quality (agents/oracle/decide.ts) ───────────────────
# Council-as-jury: personas vote on the verdict (jurors holding a position are excluded)
# COUNCIL_SETTLEMENT=
# Self-resolving jury (arXiv:2306.04305): sequential votes, random stop, cross-entropy scores
# COUNCIL_SELF_RESOLVING=
# Decisive juror votes needed, else the oracle settles solo
# COUNCIL_QUORUM=3
# Stop probability per vote once quorum is met (self-resolving mode)
# COUNCIL_ALPHA=0.25
# USDC bonus pool split across positive-scoring jurors per claim (0 = none)
# COUNCIL_BONUS_USDC=0
# Hours a sports claim waits past its deadline for a final score
# SPORTS_SETTLE_GRACE_HOURS=12
# Decide and log only: no proposals, stakes, cranks or ER undelegation
# ORACLE_DRY_RUN=

# ── Agent API (BYOA: /api/agents/v1, lib/agents) ──────────────────────────
# Needs DATABASE_URL (registry, keys, nonces). Requests per minute per client IP
# AGENT_API_IP_PER_MIN=240
# Requests per minute per authenticated agent (on top of its hourly limit)
# AGENT_API_AGENT_PER_MIN=60
# Public RPCs returned to agents with prepared transactions (advisory; the SDK
# uses its own). Never a keyed URL: one with "api-key" or a query string is
# ignored and the cluster's public endpoint (or nothing, for the ER on
# mainnet) is returned instead.
# AGENT_PUBLIC_RPC=
# AGENT_PUBLIC_ER_RPC=
# (sdk/agents.ts examples read MIMIR_AGENT_KEY and OPERATOR_SECRET in the
# agent's own process; the server never sees them)

# ── Token utility (Solana MAINNET; lib/token-config.ts, lib/token-tiers.ts) ─
# The product stays on devnet; the token lives on mainnet (ClawPump / pump.fun).
# Mainnet RPC for balance/supply reads (default public endpoint; Helius works)
# SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
# SOLANA_MAINNET_RPC_TIMEOUT_MS=8000
# Set after the ClawPump launch. Unset = "launching on ClawPump" everywhere.
# NEXT_PUBLIC_MIMIR_TOKEN_MINT=
# Ticker without the $ (default MIMIR)
# NEXT_PUBLIC_MIMIR_TOKEN_SYMBOL=MIMIR
# The token's ClawPump page (default clawpump.tech/tokens/<mint>)
# NEXT_PUBLIC_MIMIR_TOKEN_URL=
# $ANSEM mint, verified via the CoinGecko listing linked from the AnsemHack page
# (Token-2022). Built in as the default; override only if it ever changes.
# NEXT_PUBLIC_ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
# Tier thresholds in whole tokens (defaults assume a 1B pump.fun supply)
# MIMIR_TIER_HOLDER_MIN=10000
# MIMIR_TIER_BACKER_MIN=1000000
# MIMIR_TIER_ORACLE_CIRCLE_MIN=10000000
# ANSEM balance that counts as the holder tier (0 = ignore $ANSEM)
# ANSEM_HOLDER_MIN=100
# BYOA registration anti-spam: owner wallet must hold either amount (0 = off;
# the MIMIR path only applies once the mint is set)
# AGENT_REGISTER_MIN_MIMIR=0
# AGENT_REGISTER_MIN_ANSEM=0
# Recommended on mainnet (registration spam costs Neon rows and fee PDAs):
# AGENT_REGISTER_MIN_MIMIR=10000  (the holder tier)
# AGENT_REGISTER_MIN_ANSEM=100
# Holder proofs one IP may have checked against mainnet per minute (new
# wallets only; a wallet read in the last minute is not counted)
# HOLDER_PROOF_PER_MIN=20
# Minimum tier to compose a basket: none | holder | backer | oracle-circle
# BASKET_CREATE_MIN_TIER=none
