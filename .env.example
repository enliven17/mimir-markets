# =============================================================================
# Mimir environment variables (copy to .env.local; never commit secrets)
# =============================================================================
# Everything is optional for a local build: without any chain's market contracts
# and the backend (Convex) the market pages render empty. The oracle, council and market
# creator run as Convex jobs (convex/*.ts) and read their env there.

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin for canonical and Open Graph URLs (default https://mimirmarkets.xyz)
# NEXT_PUBLIC_SITE_URL=https://mimirmarkets.xyz
# The backend (realtime index, oracle, council, creator, agents): the deployment URL from `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
# Shared secrets between the site and the backend (same value in both; 16+ characters)
# MIMIR_INTERNAL_SECRET=
# MIMIR_STORE_SECRET=
# MIMIR_EVENTS_SECRET=
# MIMIR_ADMIN_SECRET=
# MIMIR_LAUNCH_SECRET=
# Proxies in front of the app that append to X-Forwarded-For; the client IP is taken this many entries from the right
# TRUSTED_PROXY_HOPS=1
# The admin panel (/admin): EVM wallets allowed in, comma separated.
ADMIN_WALLETS=
# Google Search Console HTML-tag verification. Optional.
GOOGLE_SITE_VERIFICATION=
# PostHog (instrumentation-client.ts): analytics stay off without the key. Region us | eu.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_REGION=us

# ── Wallets (ConnectKit: any EVM wallet, on Arc or Base) ──────────────────────
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Market chains (lib/chains/registry.ts; docs/CHAINS.md) ───────────────────
# Mimir runs markets on Base (primary) and Arc, each with its own contracts and its own markets. A chain is on when
# both its market contracts are set AND it is listed here. A chain with no contracts is simply off (no crash).
# Off chain every amount is USDC with 18 decimals; Base's 6-dp USDC is scaled on the way in and out.
# NEXT_PUBLIC_MARKET_CHAINS=base,arc
# Where new markets go unless the user picks another (default base when enabled, else the first enabled)
# NEXT_PUBLIC_DEFAULT_MARKET_CHAIN=base
# The backend's copies (Convex env): MARKET_CHAINS, DEFAULT_MARKET_CHAIN

# ── Base markets (contracts/MimirV3Erc20.sol, MimirPoolErc20.sol) ─────────────
# testnet (= Base Sepolia, default) or mainnet. Stakes are ERC-20 USDC (6 dp); gas is ETH.
# NEXT_PUBLIC_BASE_NETWORK=testnet
# Base RPC for markets (a comma list is tried in order); defaults to the network's public endpoint (rate limited).
# NEXT_PUBLIC_BASE_RPC=
# NEXT_PUBLIC_BASE_EXPLORER=
# Mimir contracts on Base (scripts/base/deploy-markets.mts prints these). Not deployed yet.
# NEXT_PUBLIC_MIMIR_BASE_V3_ADDRESS=
# NEXT_PUBLIC_MIMIR_BASE_POOL_ADDRESS=
# NEXT_PUBLIC_MIMIR_BASE_FEES_ADDRESS=
# Default: Circle's USDC on the network (Sepolia 0x036C…CF7e, mainnet 0x8335…2913)
# NEXT_PUBLIC_MIMIR_BASE_USDC_ADDRESS=
# NEXT_PUBLIC_MIMIR_BASE_FROM_BLOCK=
# NEXT_PUBLIC_MIMIR_BASE_MIN_STAKE=0.1
# Mimir's ERC-8021 Builder Code suffix (the encoded hex from base.dev), appended to users' Base market calldata.
# NEXT_PUBLIC_BASE_BUILDER_SUFFIX=
# The backend's copies (Convex env): BASE_NETWORK, BASE_RPC, MIMIR_BASE_V3_ADDRESS, MIMIR_BASE_POOL_ADDRESS,
# MIMIR_BASE_FEES_ADDRESS, MIMIR_BASE_USDC_ADDRESS, MIMIR_BASE_FROM_BLOCK, MIMIR_BASE_MIN_STAKE.
# BASE_RPC_HEADERS (JSON) adds headers to the backend's Base RPC calls; BASE_CONFIRMATIONS (default 6) is how many
# blocks the Base indexer stays behind its head.
# The oracle: see ORACLE_KEY below (one key, the same address on Base and Arc; there is no BASE_ORACLE_KEY).
# Mimir's Circle wallets on Base (blockchain BASE / BASE-SEPOLIA), same JSON shapes as on Arc. Each needs USDC and a
# little ETH for gas, sent by Mimir (no gas station): scripts/arc/council-wallets.ts --chain base makes the council's.
# BASE_COUNCIL_WALLETS=
# BASE_CREATOR_WALLET=

# ── Arc (lib/arc/config.ts; docs/CHAINS.md) ───────────────────────────────────
# testnet (default) or mainnet. Stakes and gas are USDC on Arc.
# NEXT_PUBLIC_ARC_NETWORK=testnet
# Mimir contracts on Arc (scripts/arc/deploy.mjs prints these). Testnet:
# NEXT_PUBLIC_MIMIR_FEES_ADDRESS=0x3ce9b9731e5b9432ceeb04bb0e27c220293a976d
# NEXT_PUBLIC_MIMIR_V3_ADDRESS=0x5c55500acefebb1559009a2735d00f25fe3e808a
# NEXT_PUBLIC_MIMIR_POOL_ADDRESS=0x4a846757db42d258ea30b29a53dac025207846fd
# NEXT_PUBLIC_MIMIR_ARC_FROM_BLOCK=65993456
# NEXT_PUBLIC_MIMIR_MIN_STAKE=0.1
# Arc RPC (a comma list is tried in order). Required on mainnet; testnet defaults to https://rpc.testnet.arc.network
# NEXT_PUBLIC_ARC_RPC=
# ARC_RPC=
# Block explorer base (default https://testnet.arcscan.app, mainnet https://arcscan.app)
# NEXT_PUBLIC_ARC_EXPLORER=
# The backend's copies (Convex env): ARC_NETWORK, ARC_RPC, MIMIR_V3_ADDRESS, MIMIR_POOL_ADDRESS, MIMIR_FEES_ADDRESS,
# MIMIR_MIN_STAKE, MIMIR_ARC_FROM_BLOCK; ARC_FEE_SIGNER_KEY.
# Council and house creator Circle wallets on Arc, as JSON ({"<slug>": {"id": "...", "address": "0x..."}}, and {"id","address"})
# ARC_COUNCIL_WALLETS=
# ARC_CREATOR_WALLET=
# MIMIR_BACKEND_OFF=1 turns every backend job into a no-op.

# ── The oracle (convex/arcOracle.ts; Convex env) ──────────────────────────────
# ONE key signs settlements on every chain: the contracts' `oracle` role is the same address on Base and Arc
# (scripts/base/deploy-markets.mts and scripts/arc/deploy.mjs take ORACLE_ADDRESS, or derive it from ORACLE_KEY, and
# refuse a mismatch with the other chain's deployed contracts). It pays gas in ETH on Base and USDC on Arc: fund both.
# ARC_ORACLE_KEY is still read as a deprecated alias when ORACLE_KEY is unset; BASE_ORACLE_KEY is no longer read.
# ORACLE_KEY=

# ── Base mainnet (agent tokens on Clanker, paid agent calls) ──────────────────
# Base mainnet RPC: server (BASE_RPC_URL) and browser (NEXT_PUBLIC_BASE_MAINNET_RPC, else NEXT_PUBLIC_BASE_RPC when
# NEXT_PUBLIC_BASE_NETWORK=mainnet); both default to the public endpoint.
# BASE_RPC_URL=
# NEXT_PUBLIC_BASE_MAINNET_RPC=
# MimirAgentPay on Base (contracts/MimirAgentPay.sol): unset = no Base offer for paid agent calls.
# BASE_AGENT_PAY_ADDRESS=
# Mimir's ERC-8021 Builder Code, appended to Base calldata.
# BASE_BUILDER_CODE=

# ── Circle developer-controlled wallets (agents, council, copy wallets) ───────
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=

# ── Mimir Launch (lib/launch; convex/launch*.ts) ──────────────────────────────
# Agents are free to create and stake from their own wallets on Base and Arc (Base also needs a little ETH for gas,
# sent by the owner; a Base wallet missing at creation is made on first use, which needs CIRCLE_WALLET_SET_ID in the
# Convex env). Backend switches (Convex env):
# LAUNCH_ARC=1             agents stake on markets (every enabled chain their rules allow)
# LAUNCH_ARC_DRY_RUN=1     decide without staking
# LAUNCH_AGENT_MARKETS=1   agents may open their own markets
# Seals an owner's own LLM key (BYOK) to its agent; 32+ characters.
# LAUNCH_BYOK_SECRET=
# Agents' own Gemini key (else the shared pool).
# LAUNCH_GEMINI_API_KEY=
# An agent's optional token is launched from its owner's wallet (Argus on Arc mainnet, Clanker on Base). Its image is
# pinned to IPFS through Pinata.
# PINATA_JWT=
# Paid agent calls (/api/launch/<agent>/call), USD per call (default 0.05)
# AGENT_API_PRICE_USD=0.05

# ── LLM (oracle, council, drafts, moderation; lib/llm.ts) ─────────────────────
# Only ONE key is needed; Gemini is preferred when both are set.
# GEMINI_API_KEY=...                       # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=sk-ant-...             # https://console.anthropic.com
# LLM_PROVIDER=gemini
# ORACLE_LLM_MODEL=gemini-3.5-flash
# The oracle's own keys: required on mainnet, never shared with web routes.
# ORACLE_GEMINI_API_KEY=
# ORACLE_ANTHROPIC_API_KEY=
# Models a settlement verdict may come from (Gemini/Claude only).
# SETTLEMENT_MODELS=gemini-3.5-flash,gemini-pro-latest,claude-sonnet-4-6
# Per-job and backup keys, fallbacks
# COUNCIL_GEMINI_API_KEY=
# CREATOR_GEMINI_API_KEY=
# GEMINI_API_KEYS=
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# ANTHROPIC_MODEL=claude-sonnet-4-6
# How long a provider sits out after a quota error (ms)
# LLM_QUOTA_COOLDOWN_MS=300000
# GROQ_QUOTA_COOLDOWN_MS=2700000
# OPENROUTER_QUOTA_COOLDOWN_MS=2700000
# OPENROUTER_APP_NAME=Mimir
# OPENROUTER_SITE_URL=https://mimirmarkets.xyz
# Jev (TypeSafe AI), optional fast triage model; empty keeps it off.
TYPESAFE_API_KEY=
JEV_MODEL=

# ── Oracle (convex/arcOracle.ts, agents/oracle) ───────────────────────────────
# ORACLE_LLM_THROTTLE_MS=1500
# COINGECKO_API_KEY=
# CMC_API_KEY=                              # a second aggregator reading (CoinGecko and Chainlink are keyless)
# CHAINLINK_RPC_URL=https://ethereum-rpc.publicnode.com
# CHAINLINK_MAX_ROUND_AGE_S=3600
# PRICE_MAX_DEADLINE_SKEW_MS=60000
# PRICE_DEFER_HOURS=6
# SPORTS_SETTLE_GRACE_HOURS=12
# POLYMARKET_READ_RETRY_HOURS=
# ALERT_WEBHOOK_URL=
# MIMIR_PAUSE_ORACLE_SETTLEMENT=1

# ── Council (convex/arcCouncil.ts, agents/council) ────────────────────────────
# COUNCIL_TRACK=                            # classic | philosopher; unset runs both
# COUNCIL_MAX_DECISIONS=12
# COUNCIL_REEVAL_MS=1800000
# COUNCIL_LLM_THROTTLE_MS=4500
# COUNCIL_MAX_CREATOR_MULTIPLE=1
# COUNCIL_RULE_PERSONAS_MAINNET=
# COUNCIL_DRY_RUN=
# MIMIR_PAUSE_COUNCIL=1

# ── House market creator (convex/arcCreator.ts, agents/market-creator) ────────
# MARKET_CREATOR_DRY_RUN=
# MARKET_CREATOR_POLYMARKET=
# MARKET_CREATOR_PREFLIGHT=
# CREATOR_STAKE_USDC=3
# ONE daily budget for the house on every chain together (its own drafts and the twins below), USDC:
# CREATOR_DAILY_BUDGET_USDC=1
# CREATOR_DAILY_MARKETS=2                   # own drafts per chain per day
# CREATOR_HORIZON_MIN=30
# CREATOR_CRYPTO_PER_RUN=2
# CREATOR_SPORTS_PER_RUN=3
# CREATOR_STOCKS_PER_RUN=1
# CREATOR_POLYMARKET_PER_RUN=2
# CREATOR_SPORTS_MAX_HOURS=72
# CREATOR_MIN_QUALITY=60
# CRYPTO_MIN_THRESHOLD_RATIO=0.65
# CRYPTO_MAX_THRESHOLD_RATIO=1.35
# MIMIR_PAUSE_CREATE_MARKET=1

# ── Market twins (convex/arcTwins.ts, lib/chains/twins.ts) ────────────────────
# Every public pool exists on every enabled chain: the house creator opens the missing leg (a user's pool after triage
# and moderation, seeded with that chain's minimum stake on the user's side; a house draft that failed on one chain)
# and links it. VS duels are not mirrored. The seeds come out of CREATOR_DAILY_BUDGET_USDC.
# TWIN_MIN_LEAD_MINUTES=30                  # no twin when betting closes sooner than this
# TWIN_PER_CREATOR_DAY=3                    # twins a day for one user's pools
# TWIN_PER_TICK=4
# TWIN_MAX_ATTEMPTS=3                       # then the twin is skipped as rejected
# TWIN_DRY_RUN=
# MIMIR_PAUSE_TWINS=1

# ── Claim drafts and moderation ───────────────────────────────────────────────
# NEXT_PUBLIC_FEATURE_SOURCE_DRAFTS=1
# CLAIM_DRAFT_MODEL=gemini-3.5-flash
# NEXT_PUBLIC_FEATURE_CLAIM_MODERATION=1
# CLAIM_MODERATION_MODEL=gemini-3.5-flash
# CLAIM_MODERATION_GLOBAL_PER_MIN=120
# CLAIM_DRAFT_GLOBAL_PER_MIN=30
# COUNCIL_PREFLIGHT_GLOBAL_PER_MIN=30

# ── Agent API (BYOA: /api/agents/v1, lib/agents) ──────────────────────────────
# Owners and operators are EVM wallets (EIP-191); writes come back as unsigned Arc transactions.
# AGENT_API_IP_PER_MIN=240
# AGENT_API_AGENT_PER_MIN=60

# ── Telegram ──────────────────────────────────────────────────────────────────
# The bot runs on its webhook (scripts/telegram-webhook.mjs set <site>); the backend posts market changes to
# /api/telegram/arc-events (set TELEGRAM_EVENTS_URL=https://<site>/api/telegram/arc-events in Convex).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ADMIN_IDS=
