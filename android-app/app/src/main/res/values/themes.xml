<resources>
    <!-- Launch: Android's splash with the horn on ink, then MainActivity's own launch screen until the page is ready. -->
    <style name="Theme.Mimir.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_maskable</item>
        <item name="postSplashScreenTheme">@style/Theme.Mimir</item>
    </style>

    <style name="Theme.Mimir" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
